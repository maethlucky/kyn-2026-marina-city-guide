<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <title>Home</title>
</head>

<body>
    <% if (!user) { %>
        <a href="/auth/github" class="btn btn-dark">Sign in with GitHub</a>
    <% } else { %>
        <p>Signed in as <%= user.display_name %></p>
        <form method="POST" action="/logout">
            <button class="btn btn-outline-secondary" type="submit">Log out</button>
        </form>
    <% } %>

    <div class="d-flex gap-2 mb-3">
        <% if (user) { %>
            <button class="btn btn-dark" id="open-favorites-btn">Favorite Locations</button>
        <% } %>
    </div>

    <div class="modal fade" id="favoritesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header">
                    <h2 class="modal-title fs-4">Favorite Locations</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3" id="favorites-container"></div>
                </div>
            </div>
        </div>
    </div>

    <a href="/submit" class="submit-btn">+ Add a Location</a>

    <section class="hero">
        <p class="hero-title">Marina, by Interest</p>
        <p class="eyebrow mb-3">Looking for something new? Find something local!</p>
        <p class="hero-copy">
            Pick a few interests and explore local spots around Marina!
        </p>

        <div class="tag-grid" id="tag-grid"></div>
        <div class="subcategory-shelf" id="subcategory-shelf"></div>

        <div class="results-shell mt-4">
            <p class="result-label mb-2">Recommended Locations</p>
            <div class="row g-3" id="results-container"></div>
        </div>
    </section>

    <div class="modal fade" id="placeDetailsModal" tabindex="-1" aria-labelledby="details-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title fs-4" id="details-title">Location Details</h2>
                        <p class="mb-0 text-muted" id="details-subtitle">Local Marina location</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="details-body">
                    <div class="detail-block">
                        <h6>Overview</h6>
                        <p>Select a result card and its details will appear here.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const isLoggedIn = <%= user ? "true" : "false" %>;
        const selectedTags = new Set();
        let tagLabels = {};
        let currentResults = [];
        let currentFavorites = [];

        fetchTags();

        document.querySelector("#tag-grid").addEventListener("click", toggleTag);
        document.querySelector("#subcategory-shelf").addEventListener("click", toggleTag);
        document.querySelector("#results-container").addEventListener("click", openPlaceFromCurrentResults);
        document.querySelector("#favorites-container").addEventListener("click", openPlaceFromFavorites);
        document.querySelector("#open-favorites-btn")?.addEventListener("click", openFavoritesModal);

        function toggleTag(e) {
            if (!e.target.classList.contains("interest-tag")) return;

            const tag = e.target.dataset.tag;

            if (e.target.dataset.hasChildren) {
                const subRow = document.getElementById(`sub-${tag}`);
                subRow.classList.toggle("visible");
                e.target.classList.toggle("active");
                return;
            }

            if (selectedTags.has(tag)) {
                selectedTags.delete(tag);
                e.target.classList.remove("active");
            } else {
                selectedTags.add(tag);
                e.target.classList.add("active");
            }

            updateResults();
        }

        async function updateResults() {
            const res = await fetch("/api/places");
            const places = await res.json();

            const scored = places
                .map((place) => ({
                    ...place,
                    score: place.tags.filter((t) => selectedTags.has(t)).length,
                }))
                .filter((p) => p.score > 0)
                .sort((a, b) => b.score - a.score);

            currentResults = scored;

            const container = document.querySelector("#results-container");
            container.innerHTML = "";

            scored.slice(0, 12).forEach((place) => {
                const col = document.createElement("div");
                col.className = "col-md-4 col-sm-6";

                col.innerHTML = `
                    <div class="result-card" data-place-id="${place.id}">
                        <h3>${place.name ?? "Name Unknown"}</h3>
                        <p>${place.tags.map((t) => tagLabels[t] ?? t).join(", ")}</p>
                    </div>
                `;

                container.appendChild(col);
            });
        }

        function openPlaceFromCurrentResults(e) {
            const card = e.target.closest(".result-card");
            if (!card) return;

            const placeId = card.dataset.placeId;
            const place = currentResults.find((p) => String(p.id) === String(placeId));
            if (!place) return;

            renderPlaceDetails(place);
            const modalEl = document.getElementById("placeDetailsModal");
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        function openPlaceFromFavorites(e) {
            const card = e.target.closest(".result-card");
            if (!card) return;

            const placeId = card.dataset.placeId;
            const place = currentFavorites.find((p) => String(p.id) === String(placeId));
            if (!place) return;

            const favoritesModalEl = document.getElementById("favoritesModal");
            const favoritesModal = bootstrap.Modal.getInstance(favoritesModalEl);
            if (favoritesModal) favoritesModal.hide();

            renderPlaceDetails(place);
            const detailsModalEl = document.getElementById("placeDetailsModal");
            const detailsModal = new bootstrap.Modal(detailsModalEl);
            detailsModal.show();
        }

        function renderPlaceDetails(place) {
            document.querySelector("#details-title").textContent = place.name ?? "Name Unknown";
            document.querySelector("#details-subtitle").textContent = "Local Marina location";

            const body = document.querySelector("#details-body");

            const websiteHtml = place.website
                ? `<a href="${place.website}" target="_blank" rel="noopener noreferrer">${place.website}</a>`
                : `<p class="text-muted mb-0">Not available</p>`;

            const phoneHtml = place.phone
                ? `<p class="mb-0">${place.phone}</p>`
                : `<p class="text-muted mb-0">Not available</p>`;

            const hoursHtml = place.hours
                ? `<p class="mb-0">${place.hours}</p>`
                : `<p class="text-muted mb-0">Not available</p>`;

            const tagHtml = (place.tags && place.tags.length)
                ? place.tags.map((t) => `<span class="detail-chip">${tagLabels[t] ?? t}</span>`).join("")
                : `<p class="text-muted mb-0">No tags available</p>`;

            const mapsUrl = (place.lat && place.lon)
                ? `https://www.google.com/maps?q=${place.lat},${place.lon}`
                : null;

            const mapsHtml = mapsUrl
                ? `<a href="${mapsUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-dark">Open in Google Maps</a>`
                : `<p class="text-muted mb-0">Map link not available</p>`;

            const favoriteHtml = isLoggedIn
                ? `<button class="btn btn-outline-dark" id="favorite-place-btn" data-place-id="${place.id}">Save to Favorites</button>`
                : "";

            body.innerHTML = `
                <div class="detail-block">
                    <h6>Tags:</h6>
                    <div class="detail-tags">${tagHtml}</div>
                </div>

                <div class="detail-block">
                    <h6>Coordinates:</h6>
                    <p class="mb-0">${place.lat ?? "?"}, ${place.lon ?? "?"}</p>
                </div>

                <div class="detail-block">
                    <h6>Phone:</h6>
                    ${phoneHtml}
                </div>

                <div class="detail-block">
                    <h6>Website:</h6>
                    ${websiteHtml}
                </div>

                <div class="detail-block">
                    <h6>Hours:</h6>
                    ${hoursHtml}
                </div>

                <div class="detail-block">
                    <h6>Actions:</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        ${mapsHtml}
                        ${favoriteHtml}
                    </div>
                </div>
            `;

            document.querySelector("#favorite-place-btn")?.addEventListener("click", async () => {
                const res = await fetch("/api/favorites", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ placeId: String(place.id) })
                });

                const data = await res.json();

                if (data.success) {
                    alert("Saved to favorites!");
                } else {
                    alert(data.error || "Could not save favorite.");
                }
            });
        }

        async function openFavoritesModal() {
            const res = await fetch("/api/favorites");
            const favorites = await res.json();
            currentFavorites = favorites;

            const container = document.querySelector("#favorites-container");
            container.innerHTML = "";

            if (!favorites.length) {
                container.innerHTML = `<div class="col-12"><p class="text-muted mb-0">No favorites saved yet.</p></div>`;
            } else {
                favorites.forEach((place) => {
                    const col = document.createElement("div");
                    col.className = "col-md-6";

                    col.innerHTML = `
                        <div class="result-card" data-place-id="${place.id}">
                            <h3>${place.name ?? "Name Unknown"}</h3>
                            <p>${(place.tags || []).map((t) => tagLabels[t] ?? t).join(", ")}</p>
                        </div>
                    `;

                    container.appendChild(col);
                });
            }

            const modalEl = document.getElementById("favoritesModal");
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function fetchTags() {
            const res = await fetch("/api/tags");
            const tags = await res.json();

            const container = document.querySelector("#tag-grid");
            const subContainer = document.querySelector("#subcategory-shelf");

            container.innerHTML = "";
            subContainer.innerHTML = "";

            tags.forEach((tag) => {
                tagLabels[tag.id] = tag.label;

                const btn = document.createElement("button");
                btn.className = "interest-tag";
                btn.dataset.tag = tag.id;
                btn.textContent = tag.label;

                if (tag.subcategories) btn.dataset.hasChildren = true;
                container.appendChild(btn);

                if (tag.subcategories) {
                    const subRow = document.createElement("div");
                    subRow.className = "subcategory-row";
                    subRow.id = `sub-${tag.id}`;

                    const subLabel = document.createElement("span");
                    subLabel.className = "subcategory-label";
                    subLabel.textContent = tag.label;
                    subRow.appendChild(subLabel);

                    tag.subcategories.forEach((sub) => {
                        tagLabels[sub.id] = sub.label;

                        const subBtn = document.createElement("button");
                        subBtn.className = "interest-tag subcategory";
                        subBtn.dataset.tag = sub.id;
                        subBtn.dataset.parent = tag.id;
                        subBtn.textContent = sub.label;
                        subRow.appendChild(subBtn);
                    });

                    subContainer.appendChild(subRow);
                }
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>