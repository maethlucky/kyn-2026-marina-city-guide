<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <title>Submit a Location</title>
</head>
<body>
    <a href="/" class="submit-btn">← Back</a>

    <section class="hero">
        <p class="hero-title">Add a Location</p>
        <p class="eyebrow mb-3">Know somewhere we're missing? Add it to the map.</p>

        <div class="submit-card">
            <form id="submit-form">
                <div class="submit-group">
                    <label class="submit-label">Location Name *</label>
                    <input class="submit-input" type="text" name="name" placeholder="e.g. Marina Coffee Co." required>
                </div>

                <div class="submit-row">
                    <div class="submit-group">
                        <label class="submit-label">Latitude *</label>
                        <input class="submit-input" type="number" name="lat" step="any" min="-90" max="90" placeholder="36.68" required>
                    </div>
                    <div class="submit-group">
                        <label class="submit-label">Longitude *</label>
                        <input class="submit-input" type="number" name="lon" step="any" min="-180" max="180" placeholder="-121.80" required>
                    </div>
                </div>

                <div class="submit-group">
                    <label class="submit-label">Phone <span class="optional">optional</span></label>
                    <input class="submit-input" type="text" name="phone" placeholder="+1 831-000-0000">
                </div>

                <div class="submit-group">
                    <label class="submit-label">Website <span class="optional">optional</span></label>
                    <input class="submit-input" type="text" name="website" placeholder="https://...">
                </div>

                <div class="submit-group">
                    <label class="submit-label">Hours <span class="optional">optional</span></label>
                    <input class="submit-input" type="text" name="hours" placeholder="e.g. Mo-Fr 09:00-17:00">
                </div>

                <div class="submit-group">
                    <label class="submit-label">Tags</label>
                    <div class="tag-grid" id="tag-grid"></div>
                    <div class="subcategory-shelf" id="subcategory-shelf"></div>
                </div>

                <!-- hidden input to carry tags to backend -->
                <input type="hidden" name="tags" id="tags-input">

                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem;">
                    <button class="interest-tag active" type="submit">Submit Location</button>
                    <p id="submit-msg" style="margin: 0; font-size: 0.85rem;"></p>
                </div>
            </form>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const selectedTags = new Set();
        let tagLabels = {};

        fetchTags();

        document.querySelector("#tag-grid").addEventListener("click", toggleTag);
        document.querySelector("#subcategory-shelf").addEventListener("click", toggleTag);

        function toggleTag(e) {
            e.preventDefault();
            if (!e.target.classList.contains("interest-tag")) return;

            const tag = e.target.dataset.tag;

            if (e.target.dataset.hasChildren) {
                const subRow = document.getElementById(`sub-${tag}`);
                subRow.classList.toggle("visible");
            }

            if (selectedTags.has(tag)) {
                selectedTags.delete(tag);
                e.target.classList.remove("active");
            } else {
                selectedTags.add(tag);
                e.target.classList.add("active");
            }
            
            console.log(selectedTags);
        }

        document.querySelector("#submit-form").addEventListener("submit", async (e) => {
            e.preventDefault();

            // populate hidden input with selected tags before sending
            document.querySelector("#tags-input").value = JSON.stringify([...selectedTags]);

            const form = e.target;
            const body = {
                name:    form.name.value,
                lat:     parseFloat(form.lat.value),
                lon:     parseFloat(form.lon.value),
                phone:   form.phone.value || null,
                website: form.website.value || null,
                hours:   form.hours.value || null,
                tags:    [...selectedTags],
            };

            const res = await fetch("/api/submit", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
            });

            const data = await res.json();
            const msg = document.querySelector("#submit-msg");

            if (data.success) {
                msg.style.color = "#4d7a70";
                msg.textContent = `Submitted! ID: ${data.id}`;
                form.reset();
                selectedTags.clear();
                document.querySelectorAll(".interest-tag.active").forEach(btn => btn.classList.remove("active"));
            } else {
                msg.style.color = "red";
                msg.textContent = data.error ?? "Something went wrong.";
            }
        });

        async function fetchTags() {
            const res = await fetch("/api/tags");
            const tags = await res.json();

            const container = document.querySelector("#tag-grid");
            const subContainer = document.querySelector("#subcategory-shelf");

            container.innerHTML = "";
            subContainer.innerHTML = "";

            tags.filter(tag => tag.id !== "editors_choice").forEach(tag => {
                tagLabels[tag.id] = tag.label;

                const btn = document.createElement("button");
                btn.className = "interest-tag";
                btn.dataset.tag = tag.id;
                btn.textContent = tag.label;
                if (tag.subcategories) btn.dataset.hasChildren = true;
                container.appendChild(btn);

                if (tag.subcategories) {
                    const subRow = document.createElement("div");
                    subRow.className = "subcategory-row";
                    subRow.id = `sub-${tag.id}`;

                    const subLabel = document.createElement("span");
                    subLabel.className = "subcategory-label";
                    subLabel.textContent = tag.label;
                    subRow.appendChild(subLabel);

                    tag.subcategories.forEach(sub => {
                        tagLabels[sub.id] = sub.label;

                        const subBtn = document.createElement("button");
                        subBtn.className = "interest-tag subcategory";
                        subBtn.dataset.tag = sub.id;
                        subBtn.dataset.parent = tag.id;
                        subBtn.textContent = sub.label;
                        subRow.appendChild(subBtn);
                    });

                    subContainer.appendChild(subRow);
                }
            });
        }
    </script>
</body>
</html>